# FinShield AI — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or any file containing real credentials.

# ─── AI Model Provider ────────────────────────────────────────────────
# Configure these two provider keys. The system works in offline demo mode
# if neither is set — results will be marked as "simulated".

# Google Gemini
GEMINI_API_KEY=

# NVIDIA Nemotron (via NVIDIA API Catalog)
NEMOTRON_API_KEY=

# Provider preference: auto (Gemini first, then NVIDIA), gemini, nemotron, or demo
AI_PROVIDER=auto

# ─── Application ───────────────────────────────────────────────────────
# Set to "true" to force demo mode even when API keys are present
FORCE_DEMO_MODE=false

# Base URL for the app (used for callbacks, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Security ──────────────────────────────────────────────────────────
# Maximum file upload size in bytes (default: 10MB)
MAX_UPLOAD_SIZE=10485760

# Worker concurrency limit
WORKER_CONCURRENCY=3

# Worker polling interval in ms
WORKER_POLL_INTERVAL=2000

# Local SQLite database path (relative to project root unless absolute)
FINSHIELD_DB_PATH=./data/finshield.sqlite
