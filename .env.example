# FinShield AI — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or any file containing real credentials.

# ─── AI Model Provider ────────────────────────────────────────────────
# The selected provider key must be configured for task evaluation.

# Google Gemini
GEMINI_API_KEY=

# NVIDIA Nemotron via OpenRouter
NEMOTRON_API_KEY=

# Provider preference: nemotron (default), gemini, or auto (Nemotron first)
AI_PROVIDER=nemotron

# Provider request deadline in milliseconds (1,000 to 120,000; default 20,000)
AI_REQUEST_TIMEOUT_MS=20000

# ─── Application ───────────────────────────────────────────────────────
# Base URL for the app (used for callbacks, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Security ──────────────────────────────────────────────────────────
# Maximum file upload size in bytes (default: 10MB)
MAX_UPLOAD_SIZE=10485760

# Worker concurrency limit
WORKER_CONCURRENCY=3

# Worker polling interval in ms
WORKER_POLL_INTERVAL=2000

# Local SQLite database path (relative to project root unless absolute)
FINSHIELD_DB_PATH=./data/finshield.sqlite
